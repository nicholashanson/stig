{
    "name": "vortex-m",
    "description": "Cortex-M emulator with TUI",
    "authors": ["nicholashanson"],
    "targetType": "executable",

    "dependencies": {
        "ncurses": "~>1.0.0"
    },

    "sourcePaths": ["."],
    "dflags": ["-verrors=0"],

    "configurations": [
        {
            "name": "default",
            "excludedSourceFiles": ["cortex_m_ui.d"]
        },
        {
            "name": "cortexm"
        },
        {
            "name": "lib",
            "targetType": "dynamicLibrary",
            "sourceFiles": ["backend_api.d"],
            "excludedSourceFiles": ["cortex_m_ui.d"]
        },
    ]
}